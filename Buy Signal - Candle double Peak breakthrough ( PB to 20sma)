//@version=6
indicator("Double Peak Buy", overlay=true, max_labels_count=500, max_lines_count=500)

// ── Inputs ────────────────────────────────────────────────────────────────────
grpMain  = "Signal Settings"
lookback = input.int(12,    "Lookback Days",                            minval=5,   maxval=30,  group=grpMain)
pk2Pct   = input.float(10.0, "Max % today above 2nd peak",              minval=0.1, step=0.1,  group=grpMain) / 100
lowBand  = input.float(2.0,  "Lowest point must be within SMA20 +/-(%)", minval=0.1, step=0.1, group=grpMain) / 100
maxBelow = input.int(3,     "Max days close below SMA20 between peaks", minval=0,   maxval=10, group=grpMain)
modPct   = input.float(3.0,  "SMA10 max gap above SMA20 (%)",           minval=0.1, step=0.1,  group=grpMain) / 100

grpMACD  = "MACD Settings"
mFast    = input.int(12, "Fast Length",   minval=1, group=grpMACD)
mSlow    = input.int(26, "Slow Length",   minval=1, group=grpMACD)
mSig     = input.int(9,  "Signal Length", minval=1, group=grpMACD)

// ── Compute ───────────────────────────────────────────────────────────────────
[macdLine, signalLine, hist] = ta.macd(close, mFast, mSlow, mSig)
sma10    = ta.sma(close, 10)
sma20    = ta.sma(close, 20)
volSma20 = ta.sma(volume, 20)

plot(sma10, "SMA10", color=color.blue, linewidth=1)
plot(sma20, "SMA20", color=color.red,  linewidth=2)

// ── Condition 1: Green candle making lookback-day HIGH ────────────────────────
greenCandle = close > open
newHigh     = high >= ta.highest(high[1], lookback - 1)
cond1       = greenCandle and newHigh

// ── Find 2nd peak: highest high in bars [1..lookback-1] ───────────────────────
pk2Val = ta.highest(high[1], lookback - 1)
pk2Bar = 0
for i = 1 to lookback - 1
    if high[i] >= pk2Val * 0.9999
        pk2Bar := i
        break

// ── Condition 2: Today high within 10% above 2nd peak ────────────────────────
cond2 = high <= pk2Val * (1 + pk2Pct)

// ── Scan bars between today and 2nd peak (bars 1..pk2Bar-1) ───────────────────
minLow      = close
minLowSMA20 = sma20
belowSMACnt = 0
hasLowVol   = false

if pk2Bar >= 2
    for i = 1 to pk2Bar - 1
        if low[i] < minLow
            minLow      := low[i]
            minLowSMA20 := sma20[i]
        if close[i] < sma20[i]
            belowSMACnt += 1
        if volume[i] < volSma20[i]
            hasLowVol   := true

// ── Condition 3: Lowest point between peaks within SMA20 ±lowBand% ────────────
lowestInRange = minLow >= minLowSMA20 * (1 - lowBand) and minLow <= minLowSMA20 * (1 + lowBand)
cond3         = lowestInRange and belowSMACnt <= maxBelow

// ── Condition 4: At least one low-volume day between peaks ────────────────────
cond4 = hasLowVol

// ── Condition 5: SMA10 moderately above SMA20 ─────────────────────────────────
cond5 = sma10 > sma20 and sma10 <= sma20 * (1 + modPct)

// ── Condition 6: Today MACD line > MACD line at 2nd peak ──────────────────────
cond6 = macdLine > macdLine[pk2Bar]

// ── Condition 7: At least 2 days gap between today and 2nd peak ───────────────
cond7 = pk2Bar >= 3

// ── Buy Signal ────────────────────────────────────────────────────────────────
buySignal = cond1 and cond2 and cond3 and cond4 and cond5 and cond6 and cond7

// ── Label & Line ──────────────────────────────────────────────────────────────
atr14   = ta.atr(14)
arrowY  = low - atr14 * 0.8
lineBtm = arrowY - atr14 * 0.6

c0  = str.tostring(high,         "#.####")
p2v = str.tostring(pk2Val,       "#.####")
pb  = str.tostring(pk2Bar)
s10 = str.tostring(sma10,        "#.####")
s20 = str.tostring(sma20,        "#.####")
bsc = str.tostring(belowSMACnt)
ml0 = str.tostring(macdLine,     "#.####")
mlP = str.tostring(macdLine[pk2Bar], "#.####")
mll = str.tostring(minLow,       "#.####")
mls = str.tostring(minLowSMA20,  "#.####")

tip = "BUY SIGNAL\n" +
      "Green candle, " + str.tostring(lookback) + "-day high: " + c0 + "\n" +
      "2nd peak high=" + p2v + " (" + pb + " bars ago)\n" +
      "Today high within " + str.tostring(pk2Pct * 100, "#.#") + "% above 2nd peak: YES\n" +
      "Lowest point between peaks=" + mll + " within +/-" + str.tostring(lowBand * 100, "#.#") + "% of SMA20=" + mls + ": YES\n" +
      "Days close < SMA20 between peaks: " + bsc + " (max " + str.tostring(maxBelow) + ")\n" +
      "Low-volume day between peaks: " + str.tostring(hasLowVol) + "\n" +
      "SMA10=" + s10 + " moderately above SMA20=" + s20 + "\n" +
      "MACD today=" + ml0 + " > MACD at 2nd peak=" + mlP + ": YES"

if buySignal
    label.new(x=bar_index, y=arrowY, text="▲", style=label.style_none, textcolor=color.yellow, size=size.huge, tooltip=tip)
    line.new(x1=bar_index, y1=arrowY, x2=bar_index, y2=lineBtm, color=color.yellow, width=4)
    line.new(x1=bar_index - pk2Bar, y1=pk2Val, x2=bar_index, y2=high, color=color.new(#ADD8E6, 0), width=5, style=line.style_dotted)

alertcondition(buySignal, title="Double Peak Buy", message="Double peak buy on {{ticker}} @ {{close}}")
